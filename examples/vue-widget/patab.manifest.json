{
  "schemaVersion": 1,
  "apiVersion": "1",
  "id": "com.example.examples-vue-widget",
  "version": "0.1.0",
  "name": {
    "default": "examples/vue-widget",
    "zh-CN": "examples/vue-widget",
    "en-US": "examples/vue-widget"
  },
  "description": {
    "default": "PaTab 官方脚手架组件示例。",
    "zh-CN": "PaTab 官方脚手架组件示例。",
    "en-US": "PaTab starter widget."
