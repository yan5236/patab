{
  "name": "@patab/widget-sdk",
  "version": "1.0.1",
  "license": "MIT",
  "description": "PaTab 自定义组件的公开 SDK 契约入口",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./dev-host": {
      "types": "./dist/devHost.d.ts",
      "import": "./dist/devHost.js",
      "default": "./dist/devHost.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/theme.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/generate-manifest-validator.mjs && node scripts/copy-theme.mjs",
    "type-check": "tsc --project tsconfig.build.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "ajv": "8.18.0"
  }
}
