{
  "manifest_version": 3,
  "name": "PaTab",
  "description": "将 PaTab 设置为 Chrome/Edge 新标签页。",
  "version": "0.2.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "sandbox": {
    "pages": [
      "custom-component-sandbox.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://api.bing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "https://permission-spike.patab.example/*"
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
