{
  "name": "patab-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:extension": "run-p type-check build-extension-only",
    "deploy": "pnpm build && npx wrangler pages deploy dist --project-name=patab-web --branch=main --commit-dirty=true",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "build-extension-only": "vite build --mode extension --base=./ --outDir dist-extension",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@patab/widget-package": "workspace:*",
    "@patab/widget-sdk": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "motion-v": "^2.3.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@rolldown/binding-win32-x64-msvc": "1.1.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
